  },
  "item": [
    {
      "name": "0. Autenticação",
      "item": [
        {
          "name": "Login profissional (CRM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoRegistro\": \"CRM\",\n  \"registro\": \"12345\",\n  \"senha\": \"senha123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Única rota pública. Salva o token na variável {{token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); pm.collectionVariables.set('token', j.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
