    {
      "name": "3. Sincronização offline-first",
      "item": [
        {
          "name": "Pull (servidor → cliente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sync/pull?desde=2026-01-01T00:00:00.000Z",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sync",
                "pull"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "2026-01-01T00:00:00.000Z"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Retorna tudo que mudou desde 'desde'. Sem o parâmetro, retorna tudo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Push (cliente → servidor) com conflito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sync/push",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sync",
                "push"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositivoId\": \"postman\",\n  \"operacoes\": [\n    {\n      \"opId\": \"{{$guid}}\",\n      \"entidade\": \"prontuario\",\n      \"dados\": {\n        \"id\": \"{{prontuarioId}}\",\n        \"pessoaId\": \"{{pessoaId}}\",\n        \"tipoSanguineo\": \"AB+\",\n        \"alergias\": \"Látex\",\n        \"comorbidades\": \"Diabetes tipo 2\",\n        \"versao\": 0,\n        \"atualizadoEm\": \"2026-11-10T15:00:00.000Z\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "versao=0 com o servidor na versão 1 => conflito. Prontuário usa a Strategy MERGE: alergias são unidas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('conflito resolvido por MERGE', () => { const r = pm.response.json().resultados[0]; pm.expect(r.status).to.eql('CONFLITO_RESOLVIDO'); pm.expect(r.registro.alergias).to.include('Dipirona'); pm.expect(r.registro.alergias).to.include('Látex'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Enviar logs do modo offline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/log",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "log"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositivoId\": \"postman\",\n  \"logs\": [\n    {\n      \"id\": \"{{$guid}}\",\n      \"dataHora\": \"2026-11-10T14:31:00.000Z\",\n      \"metodo\": \"POST\",\n      \"rota\": \"/atendimento (offline)\",\n      \"statusCode\": 201,\n      \"tempoMs\": 4.1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
