[Unit]
Description=MedicalField - auth-service (Node.js)
After=network.target postgresql.service

[Service]
User=medicalfield
WorkingDirectory=/opt/medicalfield/services/auth-service
EnvironmentFile=/opt/medicalfield/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
