[Unit]
Description=MedicalField - document-service (Python)
After=network.target medicalfield-clinical.service

[Service]
User=medicalfield
WorkingDirectory=/opt/medicalfield/services/document-service
EnvironmentFile=/opt/medicalfield/.env
ExecStart=/opt/medicalfield/services/document-service/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
