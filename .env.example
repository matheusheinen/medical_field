# Copie para .env e ajuste. Lido pelos 3 serviços (systemd: EnvironmentFile=/opt/medicalfield/.env)

# ---- Banco central (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicalfield
DB_USER=medicalfield
DB_PASSWORD=medicalfield

# ---- Segredo compartilhado do JWT. OBRIGATÓRIO (mín. 32 caracteres): os serviços não sobem sem ele.
#      Gere com: openssl rand -hex 32   (o install_vm.sh e o dev-start.sh geram automaticamente)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---- Portas internas (o Nginx expõe tudo na porta 80)
AUTH_PORT=3001
CLINICAL_PORT=8080
DOCUMENT_PORT=8000
CLINICAL_URL=http://localhost:8080

# ---- Estratégias de conflito por entidade: LWW | SERVER_WINS | MERGE
CONFLICT_STRATEGY_PESSOA=LWW
CONFLICT_STRATEGY_PRONTUARIO=MERGE
CONFLICT_STRATEGY_ATENDIMENTO=LWW

# ---- E-mail. Sem SMTP_HOST, o e-mail é salvo como .eml em services/document-service/emails_enviados/
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu@gmail.com, SMTP_PASSWORD=<senha de app de 16 letras>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM="MedicalField <seu@gmail.com>"
TIMEZONE=America/Sao_Paulo
